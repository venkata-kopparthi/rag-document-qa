# postgres (matches docker-compose.yml defaults)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_chatbot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_chatbot

# azure openai - resource name only, not the full url
# (https://my-resource.openai.azure.com -> my-resource)
AZURE_OPENAI_RESOURCE_NAME=your-azure-openai-resource-name
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-10-21

# deployment names, not model names - these come from Azure AI Foundry
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# must match the VECTOR(n) size in db/init.sql
# 1536 for text-embedding-3-small / ada-002, 3072 for text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
